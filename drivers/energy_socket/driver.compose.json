{
  "name": {
    "en": "Energy Socket",
    "de": "Energiesteckdose",
    "da": "Energistik"
  },
  "images": {
    "large": "drivers/energy_socket/assets/images/large.png",
    "small": "drivers/energy_socket/assets/images/small.png"
  },
  "class": "socket",
  "discovery": "energy_socket",
  "platforms": [
    "local"
  ],
  "capabilities": [
    "onoff",
    "dim",
    "identify",
    "locked",
    "measure_power",
    "meter_power",
    "meter_power.consumed.t1",
    "meter_power.produced.t1",
    "measure_power.l1",
    "rssi",
    "connection_error",
    "alarm_connectivity"
  ],
  "energy": {
    "meterPowerImportedCapability": "meter_power.consumed.t1",
    "meterPowerExportedCapability": "meter_power.produced.t1"
  },
  "capabilitiesOptions": {
    "measure_power": {
      "title": {
        "en": "Current usage",
        "nl": "Huidig vermogen",
        "de": "Aktueller Verbrauch",
        "da": "Aktuelt forbrug"
      },
      "insights": true
    },
    "measure_power.l1": {
      "title": {
        "en": "Current usage phase 1",
        "nl": "Huidig gebruik fase 1",
        "de": "Aktueller Verbrauch Phase 1",
        "da": "Aktuelt forbrug fase 1"
      }
    },
    "meter_power.consumed.t1": {
      "decimals": 3,
      "title": {
        "en": "Total t1 usage",
        "nl": "Totaal t1 gebruik",
        "de": "Gesamt T1 Verbrauch",
        "da": "Samlet T1 forbrug"
      }
    },
    "meter_power.produced.t1": {
      "decimals": 3,
      "title": {
        "en": "Total t1 deliver",
        "nl": "Totaal t1 teruglevering",
        "de": "Gesamt T1 Einspeisung",
        "da": "Samlet T1 levering"
      }
    },
    "meter_power": {
      "decimals": 3,
      "title": {
        "en": "Total usage KWh",
        "nl": "Totaal verbruik KWh",
        "de": "Gesamtverbrauch kWh",
        "da": "Samlet forbrug kWh"
      }
    },
    "measure_voltage.l1": {
      "title": {
        "en": "Current Voltage phase 1",
        "nl": "Huidig Voltage fase 1",
        "de": "Aktuelle Spannung Phase 1",
        "da": "Aktuel Spænding fase 1"
      },
      "insights": true
    }
  },
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Energy Socket settings",
        "nl": "Energy Socket instellingen",
        "de": "Energiesteckdosen-Einstellungen",
        "da": "Energistik indstillinger"
      },
      "children": [
        {
          "id": "offset_socket",
          "type": "number",
          "label": {
            "en": "Offset Watt usage",
            "nl": "Compensatie watt gebruik",
            "de": "Versatz Watt-Verbrauch",
            "da": "Forskydning Watt forbrug"
          },
          "value": 0,
          "unit": {
            "en": "watt",
            "nl": "watt",
            "de": "Watt",
            "da": "Watt"
          }
        },
        {
          "id": "offset_polling",
          "type": "number",
          "label": {
            "en": "Polling in seconds",
            "nl": "Interval in seconden",
            "de": "Abfrage in Sekunden",
            "da": "Afspørgning i sekunder"
          },
          "value": 10,
          "min": 2
        },
        {
          "id": "cloud",
          "type": "number",
          "label": {
            "en": "Cloud connection 1=on 0=off",
            "nl": "Cloud verbinding 1=actief 0=uit",
            "de": "Cloud-Verbindung 1=ein 0=aus",
            "da": "Sky-forbindelse 1=til 0=fra"
          },
          "value": 1
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Appliance detection",
        "nl": "Apparaat detectie",
        "de": "Geräteerkennung",
        "da": "Apparatgenkendelse"
      },
      "children": [
        {
          "id": "appliance_detection_enabled",
          "type": "checkbox",
          "label": {
            "en": "Enable appliance detection",
            "nl": "Apparaat detectie inschakelen",
            "de": "Geräteerkennung aktivieren",
            "da": "Aktiver apparatgenkendelse"
          },
          "value": false
        },
        {
          "id": "active_threshold_w",
          "type": "number",
          "label": {
            "en": "Active threshold (W)",
            "nl": "Actief-drempel (W)",
            "de": "Aktiv-Schwelle (W)",
            "da": "Aktiv grænse (W)"
          },
          "value": 50,
          "min": 1
        },
        {
          "id": "standby_threshold_w",
          "type": "number",
          "label": {
            "en": "Standby threshold (W)",
            "nl": "Stand-by drempel (W)",
            "de": "Standby-Schwelle (W)",
            "da": "Standby-grænse (W)"
          },
          "value": 5,
          "min": 0
        },
        {
          "id": "min_active_minutes",
          "type": "number",
          "label": {
            "en": "Min active duration (min)",
            "nl": "Min actieve duur (min)",
            "de": "Min. aktive Dauer (min)",
            "da": "Min. aktiv varighed (min)"
          },
          "value": 5,
          "min": 0
        },
        {
          "id": "trigger_on_poweroff",
          "type": "checkbox",
          "label": {
            "en": "Also trigger on power-off (0W)",
            "nl": "Ook triggeren bij volledige uitschakeling (0W)",
            "de": "Auch bei Abschaltung auslösen (0W)",
            "da": "Udløs også ved slukning (0W)"
          },
          "value": true
        }
      ]
    }
  ],
  "pair": [
    {
      "id": "start",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}

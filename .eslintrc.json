{
  "env": {
    "node": true,
    "es2021": true
  },
  "rules": {
    "brace-style": "off",
    "camelcase": "off",
    "consistent-return": "off",
    "eqeqeq": "off",
    "func-names": "off",
    "global-require": "off",
    "guard-for-in": "off",
    "import/extensions": "off",
    "max-len": 0,
    "no-async-promise-executor": "off",
    "no-cond-assign": "off",
    "no-console": "off",
    "no-const-assign": "off",
    "no-constant-condition": "off",
    "no-mixed-spaces-and-tabs": "off",
    "no-new": "off",
    "no-trailing-spaces": "off",
    "no-restricted-syntax": "off",
    "no-restricted-properties": ["error", {
      "object": "process",
      "property": "memoryUsage",
      "message": "Throws ENOENT (uv_resident_set_memory) in the Homey sandbox. Use v8.getHeapStatistics(); if rss is truly needed, wrap in try/catch and add an eslint-disable line."
    }],
    "no-tabs": "off",
    "no-undef": "off",
    "comma-dangle": "off",
    "no-unused-vars": "off",
    "no-multi-spaces": "off",
    "node/no-unsupported-features/node-builtins": "off",
    "no-multiple-empty-lines": "off",
    "padding-line-between-statements": "off",
    "radix": "off",
    "indent": "off",
    "valid-typeof": "off",
    "import/no-commonjs": "off",
    "no-useless-concat": "off",
    "linebreak-style": 0,
    "object-curly-newline": "off",
    "object-property-newline": "off",
    "quote-props": "off",
    "node/no-commonjs": "off",
    "quotes": "off",
    "prefer-template": "off"
  },
  "overrides": [
    {
      "files": [
        "drivers/battery-policy/*.js"
      ],
      "rules": {
        "no-restricted-syntax": ["error", {
          "selector": "CallExpression[callee.property.name='toLocaleDateString'][arguments.length>1]",
          "message": "Constructs a fresh Intl.DateTimeFormat per call; this file calls it per slot inside the policy loop. Use the module-level _amsDayKeyFormatter.format(d). Only add an eslint-disable line for genuinely one-shot paths, with the reason."
        }]
      }
    }
  ]
}
